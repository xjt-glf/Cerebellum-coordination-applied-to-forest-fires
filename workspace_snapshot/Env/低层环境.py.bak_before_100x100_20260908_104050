        #上一个时间步的探索率
        self.coverage_pre = 0.0
        #已选选项数
        self.option_counts = np.zeros(5, dtype=np.int32)
        #是否到达覆盖率
        self._has_reached_th_on = False

        self.head_len_pre  = 0    # 上一时刻的三类长度（切换惩罚中的“是否集合已空”判断）
        self.flank_len_pre = 0
        self.tail_len_pre  = 0

        
